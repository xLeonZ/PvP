local function resolveShotLater(shot)
    task.delay(math.max(2.0,shot.horizon+0.9),function()
        if shot.finalHit then return end
        local p=profiles[shot.targetUserId]
        if not p then return end

        if shot.projectileTracked then
            if shot.minProjectileDistance and shot.minProjectileDistance<=shot.contactThreshold then
                markShotHit(shot,"probable","tracked-projectile-near-target")
            else
                p.trackedMisses += 1
                shot.resolvedMiss=true

                -- Very small correction from a high-quality tracked miss. Positive along-target
                -- error means the projectile was behind the moving target at closest approach.
                if shot.closestError and shot.closestTargetVelocity and shot.closestTargetVelocity.Magnitude>6 then
                    local dir=shot.closestTargetVelocity.Unit
                    local along=shot.closestError:Dot(dir)
                    local dtError=along/shot.closestTargetVelocity.Magnitude
                    p.leadBiasSeconds=math.clamp(p.leadBiasSeconds+math.clamp(dtError,-0.16,0.16)*0.035,-0.22,0.34)
                end
            end
        end
    end)
end

-- ===== Visible projectile detection / calibration / probable contact =====
local function pickShotForProjectile(obj)
    local now=os.clock()
    local best,bestScore=nil,-math.huge
    for i=#shots,1,-1 do
        local s=shots[i]
        local age=now-s.fireTime
        if age>=0 and age<=0.50 and not s.projectile then
            local d=(obj.Position-s.serverOrigin).Magnitude
            if d<=42 then
                local score=1-d/42-age*0.7
                local nm=string.lower(obj.Name)
                if string.find(nm,"fire",1,true) or string.find(nm,"ball",1,true) or string.find(nm,"orb",1,true) or string.find(nm,"electro",1,true) then
                    score += 0.35
                end
                if score>bestScore then best,bestScore=s,score end
            end
        end
    end
    return best
end

local function trackProjectileCandidate(obj,shot)
    if not obj.Parent or shot.projectile then return end
    local p0=obj.Position
    local t0=os.clock()
    task.wait(0.045)
    if not obj.Parent or shot.projectile then return end

    local dt=os.clock()-t0
    local delta=obj.Position-p0
    local speed=dt>0 and delta.Magnitude/dt or 0
    if speed<MIN_PROJECTILE_SPEED or speed>MAX_PROJECTILE_SPEED then return end
    if delta.Magnitude<0.03 then return end
    local alignment=delta.Unit:Dot(shot.direction)
    if alignment<0.70 then return end

    shot.projectile=obj
    shot.projectileTracked=true
    shot.contactThreshold=math.clamp(obj.Size.Magnitude*0.45+3.8,4.0,10.0)

    local observedSpeeds={speed}
    local touchConn=nil
    local okTouch=pcall(function()
        touchConn=obj.Touched:Connect(function(hit)
            if shot.targetCharacter and hit and hit:IsDescendantOf(shot.targetCharacter) then
                shot.probableContact=true
                shot.minProjectileDistance=0
            end
        end)
    end)

    task.spawn(function()
        local lastPos=obj.Position
        local lastT=os.clock()
        local endAt=shot.fireTime+math.max(2.1,shot.horizon+0.9)

        while obj.Parent and os.clock()<endAt do
            RunService.Heartbeat:Wait()
            if not obj.Parent then break end
            local now=os.clock()
            local dtt=now-lastT
            if dtt>0.012 then
                local pos=obj.Position
                local ds=(pos-lastPos).Magnitude/dtt
                if ds>=MIN_PROJECTILE_SPEED and ds<=MAX_PROJECTILE_SPEED then table.insert(observedSpeeds,ds) end
                lastPos,lastT=pos,now

                local targetChar=shot.targetPlayer and shot.targetPlayer.Character
                local thrp=getHRP(targetChar)
                if thrp then
                    local dist=(pos-thrp.Position).Magnitude
                    if not shot.minProjectileDistance or dist<shot.minProjectileDistance then
                        shot.minProjectileDistance=dist
                        shot.closestError=thrp.Position-pos
                        local prof=profiles[shot.targetUserId]
                        shot.closestTargetVelocity=prof and prof.fastVel or ZERO
                    end
                    if dist<=shot.contactThreshold then shot.probableContact=true end
                end
            end
        end

        if touchConn then pcall(function() touchConn:Disconnect() end) end

        if #observedSpeeds>=2 then
            table.sort(observedSpeeds)
            local median=observedSpeeds[math.ceil(#observedSpeeds/2)]
            projectileCalibrationSamples += 1
            local alpha=projectileCalibrationSamples<=2 and 0.58 or 0.20
            projectileSpeedModel += (median-projectileSpeedModel)*alpha
            print(string.format("[AdaptiveFireball-V4] Projectile calibrated %.1f stud/s (sample %.1f, n=%d)",projectileSpeedModel,median,projectileCalibrationSamples))
        end

        if shot.probableContact and not shot.finalHit then
            -- Contact alone is not authoritative because client physics/touch can be imperfect.
            -- Wait briefly for a server event; otherwise keep it as probable.
            task.delay(0.20,function()
                if not shot.finalHit then markShotHit(shot,"probable","tracked-projectile-contact") end
            end)
        end
    end)
end

local function considerProjectileCandidate(obj)
    if not obj:IsA("BasePart") or belongsToCharacter(obj) then return end
    local shot=pickShotForProjectile(obj)
    if not shot then return end
    task.defer(function() trackProjectileCandidate(obj,shot) end)
end

STATE.ProjectileConn=Workspace.DescendantAdded:Connect(considerProjectileCandidate)

