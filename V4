-- Touch/mouse dragging, useful on phones where the default position covers gameplay.
do
    local dragging = false
    local dragStart = nil
    local startPos = nil
    local dragInput = nil

    title.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.Touch
            or inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = inp.Position
            startPos = frame.Position

            inp.Changed:Connect(function()
                if inp.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    title.InputChanged:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.Touch
            or inp.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = inp
        end
    end)

    STATE.DragConn = UserInputService.InputChanged:Connect(function(inp)
        if dragging and inp == dragInput and dragStart and startPos then
            local delta = inp.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

-- ===== Fire =====
local function fireAtTarget()
    local now=os.clock()
    if now-lastFire<COOLDOWN then return end

    local targetPlayer=findPlayerByPartial(targetName)
    if not targetPlayer or not isAlive(targetPlayer.Character) then
        autoFire=false
        status.Text="Target unavailable/dead - Auto stopped"
        status.TextColor3=Color3.fromRGB(255,90,90)
        updateAutoButton()
        return
    end
    if not isAlive(LocalPlayer.Character) then
        autoFire=false
        status.Text="You died - Auto stopped"
        status.TextColor3=Color3.fromRGB(255,90,90)
        updateAutoButton()
        return
    end

    local targetChar=targetPlayer.Character
    local targetHRP=getHRP(targetChar)
    local targetPart=getTargetPart(targetChar)
    local targetHum=getHumanoid(targetChar)
    local localHRP=getHRP(LocalPlayer.Character)
    if not targetHRP or not targetPart or not localHRP then return end

    local profile=updateProfile(targetPlayer,targetHRP)
    local pingMs=getPingMs()
    local origin=localHRP.Position
    local distance=(targetHRP.Position-origin).Magnitude
    if distance>MAX_DISTANCE then
        status.Text=string.format("Target %.0f studs away (max %d)",distance,MAX_DISTANCE)
        status.TextColor3=Color3.fromRGB(255,190,90)
        return
    end

    local localVelocity=localHRP.AssemblyLinearVelocity
    local aimPos,predictedHRP,horizon,travelTime,networkLead,serverOrigin=
        calculateAim(origin,localVelocity,targetHRP,targetPart,profile,pingMs)

    local direction=aimPos-serverOrigin
    if direction.Magnitude<0.1 then return end

    lastFire=now
    local shot={
        fireTime=now,
        targetPlayer=targetPlayer,
        targetUserId=targetPlayer.UserId,
        targetCharacter=targetChar,
        targetHumanoid=targetHum,
        targetPart=targetPart,
        serverOrigin=serverOrigin,
        aimPos=aimPos,
        predictedHRP=predictedHRP,
        horizon=horizon,
        travelTime=travelTime,
        networkLead=networkLead,
        expectedImpactTime=now+horizon,
        pingMs=pingMs,
        direction=direction.Unit,
        mode=profile.movementMode,
        projectile=nil,
        projectileTracked=false,
        probableContact=false,
        finalHit=false,
        minProjectileDistance=nil,
        contactThreshold=6,
    }
    table.insert(shots,shot)
    while #shots>MAX_SHOTS_KEPT do table.remove(shots,1) end
    profile.shotsFired += 1

    local ok,err=pcall(function() remote:FireServer(aimPos,"NewFireball") end)
    if not ok then
        warn("[AdaptiveFireball-V4] FireServer failed:",err)
        return
    end

    scheduleResidualLearning(targetPlayer,profile,predictedHRP,horizon,profile.fastVel,profile.jukeEMA)
    resolveShotLater(shot)

    status.TextColor3=Color3.fromRGB(120,255,120)
    status.Text=string.format("%s -> %s | %s | shots %d\nCooldown: 1.50s",targetPlayer.Name,BODY_PARTS[currentBodyPartIndex].name,profile.movementMode,profile.shotsFired)

    print(string.format(
        "[AdaptiveFireball-V4] %s | %s | dist %.1f | vel %.1f | ping %.0f±%.0fms | C %.2f O %.2f T %.2f J %.2f JP %.2f F %.2f | lead %.3f | proj %.1f",
        targetPlayer.Name,profile.movementMode,distance,profile.fastVel.Magnitude,pingMs,pingJitterMs,
        profile.circleConfidence,profile.orbitConfidence,profile.coordinatedTurnConfidence,profile.jukeEMA,
        profile.jumpConfidence,profile.flightConfidence,horizon,projectileSpeedModel
    ))
end

-- ===== Auto loop =====
local function startAuto()
    if STATE.AutoConn then return end
    -- Learn one full cooldown before the first shot.
    lastFire=os.clock()

    STATE.AutoConn=RunService.Heartbeat:Connect(function()
        if not autoFire or targetName=="" then return end

        local targetPlayer=findPlayerByPartial(targetName)
        if not targetPlayer or not isAlive(targetPlayer.Character) then
            autoFire=false
            status.Text="Target unavailable/dead - Auto stopped"
            status.TextColor3=Color3.fromRGB(255,90,90)
            updateAutoButton()
            return
        end
        if not isAlive(LocalPlayer.Character) then
            autoFire=false
            status.Text="You died - Auto stopped"
            status.TextColor3=Color3.fromRGB(255,90,90)
            updateAutoButton()
            return
        end

        local targetHRP=getHRP(targetPlayer.Character)
        local localHRP=getHRP(LocalPlayer.Character)
        if targetHRP and localHRP then
            local profile=updateProfile(targetPlayer,targetHRP)
            local pingMs=getPingMs()
            local dist=(localHRP.Position-targetHRP.Position).Magnitude
            local targetPart=getTargetPart(targetPlayer.Character)
            local horizon,networkLead=0,0
            if targetPart then
                local _,_,h,_,nl=calculateAim(localHRP.Position,localHRP.AssemblyLinearVelocity,targetHRP,targetPart,profile,pingMs)
                horizon,networkLead=h,nl
            end

            telemetry.Text=string.format(
                "Mode: %s | Dist: %.0f | Speed: %.1f | Ping: %.0f±%.0fms\nC: %.2f O: %.2f T: %.2f J: %.2f | Jump/Fly: %.2f/%.2f\nHits C/P/M: %d/%d/%d | Lead: %.3fs | Proj: %.1f",
                profile.movementMode,dist,profile.fastVel.Magnitude,pingMs,pingJitterMs,
                profile.circleConfidence,profile.orbitConfidence,profile.coordinatedTurnConfidence,profile.jukeEMA,
                profile.jumpConfidence,profile.flightConfidence,
                profile.confirmedHits,profile.probableHits,profile.trackedMisses,horizon,projectileSpeedModel
            )
        end

        fireAtTarget()
    end)
end

local function stopAuto()
    if STATE.AutoConn then
        STATE.AutoConn:Disconnect()
        STATE.AutoConn=nil
    end
    telemetry.Text="Mode: — | Dist: — | Speed: — | Ping: —\nC: — O: — T: — J: — | Jump/Fly: —/—\nHits C/P/M: —/—/— | Lead: — | Proj: —"
end

