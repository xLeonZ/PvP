-- ===== Hitbox implementation =====
local function rememberOriginalHRP(hrp)
    if originalHitboxState[hrp] then return end
    originalHitboxState[hrp] = {
        Size = hrp.Size,
        Transparency = hrp.Transparency,
        BrickColor = hrp.BrickColor,
        Material = hrp.Material,
        CanCollide = hrp.CanCollide,
    }
end

local function restoreHRP(hrp)
    local o = originalHitboxState[hrp]
    if not o or not hrp.Parent then return end
    pcall(function()
        hrp.Size = o.Size
        hrp.Transparency = o.Transparency
        hrp.BrickColor = o.BrickColor
        hrp.Material = o.Material
        hrp.CanCollide = o.CanCollide
    end)
end

local function restoreAllHitboxes()
    for hrp in pairs(originalHitboxState) do restoreHRP(hrp) end
end
STATE.RestoreHitboxes = restoreAllHitboxes

STATE.HitboxConn = RunService.RenderStepped:Connect(function()
    if not _G.Enabled then return end
    local size = math.clamp(tonumber(_G.HitboxSize) or 6.5, 1, 25)
