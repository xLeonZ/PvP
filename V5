    local old = _G[globalName]
    if old then
        if old.RestoreHitboxes then
            pcall(old.RestoreHitboxes)
        end
        for _, key in ipairs({
            "InputConn", "AutoConn", "ProjectileConn", "DragConn", "DamageConn", "MainRemoteConn", "HitboxConn", "PlayerAddedConn", "PlayerRemovingConn"
        }) do
            if old[key] then
                pcall(function() old[key]:Disconnect() end)
            end
        end
        if old.GUI then
            pcall(function() old.GUI:Destroy() end)
        end
        _G[globalName] = nil
    end
end

