local function destroyScript()
    if destroyed then return end
    destroyed = true
    autoFire = false
    _G.Enabled = false
    restoreAllHitboxes()
    stopAuto()

    for _, key in ipairs({
        "InputConn", "ProjectileConn", "DragConn", "DamageConn", "MainRemoteConn",
        "HitboxConn", "PlayerAddedConn", "PlayerRemovingConn"
    }) do
        if STATE[key] then
            pcall(function() STATE[key]:Disconnect() end)
            STATE[key] = nil
        end
    end

    if gui then gui:Destroy() end
    _G.FireballAdaptiveV5 = nil
    print("[AdaptiveFireball-V5] Destroyed.")
end

miniToggle.Activated:Connect(function()
    frame.Visible = not frame.Visible
    if frame.Visible then rebuildPlayerList() end
end)
closeX.Activated:Connect(function() frame.Visible = false end)
autoButton.Activated:Connect(toggleAuto)
input.FocusLost:Connect(function(enterPressed)
    if enterPressed then lockTargetFromBox() end
end)

-- Live player list updates when somebody joins/leaves.
STATE.PlayerAddedConn = Players.PlayerAdded:Connect(function()
    task.defer(rebuildPlayerList)
end)
STATE.PlayerRemovingConn = Players.PlayerRemoving:Connect(function(player)
    profiles[player.UserId] = nil
    if player.Name == targetName then
        targetName = ""
        autoFire = false
        stopAuto()
        updateAutoButton()
        selectedLabel.Text = "Selected: none"
        status.TextColor3 = Color3.fromRGB(255, 190, 90)
        status.Text = "Selected player left the server."
    end
    task.defer(rebuildPlayerList)
end)

local keyLock = {f10=false, f8=false, v=false, n=false}
STATE.InputConn = UserInputService.InputBegan:Connect(function(inp, processed)
    if processed then return end
    local kc = inp.KeyCode

    if kc == Enum.KeyCode.F10 and not keyLock.f10 then
        keyLock.f10 = true
        frame.Visible = not frame.Visible
        if frame.Visible then rebuildPlayerList() end
        task.delay(0.18, function() keyLock.f10 = false end)
        return
    end

    if kc == Enum.KeyCode.F8 and not keyLock.f8 then
        keyLock.f8 = true
        toggleHitbox()
        task.delay(0.18, function() keyLock.f8 = false end)
        return
    end

    if kc == Enum.KeyCode.V and not keyLock.v then
        keyLock.v = true
        toggleAuto()
        task.delay(0.18, function() keyLock.v = false end)
        return
    end

    -- Optional quick cycle; GUI dropdown remains the main body selector.
    if kc == Enum.KeyCode.N and not keyLock.n then
        keyLock.n = true
        cycleBodyPart()
        task.delay(0.18, function() keyLock.n = false end)
        return
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    if autoFire and targetName ~= "" then startAuto() end
end)

