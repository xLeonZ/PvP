-- ===== Searchable player list =====
local playerRows = {}
local currentFiltered = {}

local function clearPlayerRows()
    for _, row in ipairs(playerRows) do row:Destroy() end
    table.clear(playerRows)
    table.clear(currentFiltered)
end

local function scorePlayerForQuery(player, query)
    if query == "" then return 3 end
    local u = string.lower(player.Name)
    local d = string.lower(player.DisplayName)
    if string.sub(u, 1, #query) == query then return 0 end
    if string.sub(d, 1, #query) == query then return 1 end
    if string.find(u, query, 1, true) or string.find(d, query, 1, true) then return 2 end
    return nil
end

local function selectPlayer(player)
    if not player or player == LocalPlayer then return end
    targetName = player.Name
    input.Text = player.Name
    selectedLabel.Text = string.format("Selected: %s  (@%s)", player.DisplayName, player.Name)
    status.TextColor3 = Color3.fromRGB(143, 234, 168)
    status.Text = "Target locked: " .. player.Name
end

local function rebuildPlayerList()
    local query = string.lower(input.Text or "")
    clearPlayerRows()

    local matches = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local score = scorePlayerForQuery(p, query)
            if score ~= nil then table.insert(matches, {player=p, score=score}) end
        end
    end

    table.sort(matches, function(a, b)
        if a.score ~= b.score then return a.score < b.score end
        return string.lower(a.player.Name) < string.lower(b.player.Name)
    end)

    for index, item in ipairs(matches) do
        local p = item.player
        table.insert(currentFiltered, p)
        local row = Instance.new("TextButton")
        row.Name = "Player_" .. p.Name
        row.Size = UDim2.new(1, -2, 0, 34)
        row.BackgroundColor3 = (p.Name == targetName) and Color3.fromRGB(37, 55, 47) or Color3.fromRGB(31, 32, 39)
        row.BorderSizePixel = 0
        row.Text = string.format("%s   @%s", p.DisplayName, p.Name)
        row.TextColor3 = Color3.fromRGB(226, 228, 235)
        row.Font = Enum.Font.Gotham
        row.TextSize = 11
        row.TextXAlignment = Enum.TextXAlignment.Left
        row.LayoutOrder = index
        row.Parent = playerList
        round(row, 6)
        local rp = Instance.new("UIPadding")
        rp.PaddingLeft = UDim.new(0, 9)
        rp.Parent = row
        row.Activated:Connect(function()
            selectPlayer(p)
            rebuildPlayerList()
        end)
        table.insert(playerRows, row)
    end

    local totalHeight = 10 + #matches * 38
    playerList.CanvasSize = UDim2.new(0, 0, 0, totalHeight)
end

