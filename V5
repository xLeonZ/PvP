    local found = findPlayerByPartial(input.Text)
    if found then
        selectPlayer(found)
        rebuildPlayerList()
    else
        status.TextColor3 = Color3.fromRGB(255, 115, 125)
        status.Text = "No player matched that search."
    end
end

