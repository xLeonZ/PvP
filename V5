local function regressionVelocity(samples, windowSeconds)
    local n = #samples
    if n < 2 then return ZERO end
    local now = samples[n].t
    local first = n
    while first > 1 and (now - samples[first - 1].t) <= windowSeconds do
        first -= 1
    end
    if n - first + 1 < 2 then return ZERO end

    local meanT, meanP, weightSum = 0, ZERO, 0
    for i = first, n do
        local age = now - samples[i].t
        local w = math.exp(-age / math.max(windowSeconds, 0.001))
        meanT += samples[i].t * w
        meanP += samples[i].pos * w
        weightSum += w
    end
    if weightSum <= 0 then return ZERO end
    meanT /= weightSum
    meanP /= weightSum

    local numerator, denominator = ZERO, 0
    for i = first, n do
        local age = now - samples[i].t
        local w = math.exp(-age / math.max(windowSeconds, 0.001))
        local dt = samples[i].t - meanT
        numerator += (samples[i].pos - meanP) * (dt * w)
        denominator += dt * dt * w
    end
    if denominator < 1e-7 then return ZERO end
    return numerator / denominator
end

local function weightedSlope(values)
    -- values = { {t=, v=, w=} ... }
    if #values < 2 then return 0 end
    local sw, mt, mv = 0, 0, 0
    for _, q in ipairs(values) do
        sw += q.w
        mt += q.t * q.w
        mv += q.v * q.w
    end
    if sw <= 0 then return 0 end
    mt /= sw
    mv /= sw
    local num, den = 0, 0
    for _, q in ipairs(values) do
        local dt = q.t - mt
        num += q.w * dt * (q.v - mv)
        den += q.w * dt * dt
    end
    if den < 1e-8 then return 0 end
    return num / den
end

-- Weighted least-squares circle fit over ALL recent XZ samples instead of V3's fragile
-- three-point circumcircle. Also estimates angular velocity and radial drift (spirals).
local function fitRecentCircle(profile)
    local samples = profile.samples
    local n = #samples
    if n < 8 then return nil, 0, 0, 0, 0 end

    local now = samples[n].t
    local first = n
    while first > 1 and (now - samples[first - 1].t) <= CIRCLE_FIT_WINDOW do
        first -= 1
    end
    local count = n - first + 1
    if count < 8 then return nil, 0, 0, 0, 0 end

    local duration = samples[n].t - samples[first].t
    if duration < 0.24 then return nil, 0, 0, 0, 0 end

    local sw, mx, mz = 0, 0, 0
    for i = first, n do
        local age = now - samples[i].t
        local w = math.exp(-age / 0.42)
        sw += w
        mx += samples[i].pos.X * w
        mz += samples[i].pos.Z * w
    end
    if sw <= 0 then return nil, 0, 0, 0, 0 end
    mx, mz = mx/sw, mz/sw

    local suu,suv,svv,su,sv = 0,0,0,0,0
    local bu,bv,b0 = 0,0,0
    for i = first, n do
        local age = now - samples[i].t
        local w = math.exp(-age / 0.42)
        local u = samples[i].pos.X - mx
        local v = samples[i].pos.Z - mz
        local q = u*u + v*v
        suu += w*u*u
        suv += w*u*v
        svv += w*v*v
        su += w*u
        sv += w*v
        bu += -w*u*q
        bv += -w*v*q
        b0 += -w*q
    end

    local D,E,F = solve3x3(suu,suv,su, suv,svv,sv, su,sv,sw, bu,bv,b0)
    if not D then return nil,0,0,0,0 end

    local cx = mx - D/2
    local cz = mz - E/2
    local radiusSq = (D*D + E*E)/4 - F
    if radiusSq <= 0 then return nil,0,0,0,0 end
    local radius = math.sqrt(radiusSq)
    if radius < MIN_CIRCLE_RADIUS or radius > MAX_CIRCLE_RADIUS then
        return nil,0,0,0,0
    end

    local angleValues, radiusValues = {}, {}
    local totalResidual, maxResidual, weightResidual = 0, 0, 0
    local prevRaw, unwrapped = nil, nil
    local firstUnwrapped, lastUnwrapped = nil, nil

    for i = first, n do
        local pos = samples[i].pos
        local dx, dz = pos.X-cx, pos.Z-cz
        local r = math.sqrt(dx*dx + dz*dz)
        local raw = math.atan2(dz, dx)
        if prevRaw == nil then
            unwrapped = raw
            firstUnwrapped = raw
        else
            local diff = raw - prevRaw
            while diff > math.pi do diff -= 2*math.pi end
            while diff < -math.pi do diff += 2*math.pi end
            unwrapped += diff
        end
        prevRaw = raw
        lastUnwrapped = unwrapped

        local age = now - samples[i].t
        local w = math.exp(-age / 0.42)
        table.insert(angleValues, {t=samples[i].t, v=unwrapped, w=w})
        table.insert(radiusValues, {t=samples[i].t, v=r, w=w})

        local err = math.abs(r-radius)
        totalResidual += err*w
        weightResidual += w
        maxResidual = math.max(maxResidual, err)
    end

    local omega = weightedSlope(angleValues)
    local radialSpeed = weightedSlope(radiusValues)
    if math.abs(omega) > MAX_CIRCLE_OMEGA then return nil,0,0,0,0 end

    local arc = math.abs((lastUnwrapped or 0) - (firstUnwrapped or 0))
    local meanResidual = totalResidual / math.max(weightResidual, 1e-6)
    local relativeResidual = meanResidual / math.max(radius,1)
    local residualScore = math.clamp(1 - relativeResidual/0.10, 0, 1)
    local worstScore = math.clamp(1 - (maxResidual/math.max(radius,1))/0.28, 0, 1)
    local arcScore = math.clamp((arc-MIN_CIRCLE_ARC)/math.rad(42), 0, 1)

    local directionMatches, directionTotal = 0, 0
    for i=2,#angleValues do
        local d = angleValues[i].v-angleValues[i-1].v
        if math.abs(d) > math.rad(0.4) then
            directionTotal += 1
            if signOf(d) == signOf(omega) then directionMatches += 1 end
        end
    end
    local directionScore = directionTotal > 0 and directionMatches/directionTotal or 0

    local tangentialExpected = math.abs(omega)*radius
    local measuredHorizontal = horizontal(profile.fastVel).Magnitude
    local speedAgreement = 1 - math.clamp(math.abs(tangentialExpected-measuredHorizontal)/math.max(measuredHorizontal,12),0,1)
    local radialPenalty = math.clamp(1 - math.abs(radialSpeed)/math.max(measuredHorizontal*0.65,10), 0.25, 1)

    local confidence = residualScore*worstScore*(0.25+0.75*arcScore)*(0.25+0.75*directionScore)*(0.45+0.55*speedAgreement)*radialPenalty
    confidence = math.clamp(confidence,0,1)

    return Vector3.new(cx, samples[n].pos.Y, cz), radius, omega, radialSpeed, confidence
end

local function updateProfile(player, hrp)
    local p = getProfile(player)
    local now = os.clock()
    if p.lastSampleT and now-p.lastSampleT < SAMPLE_INTERVAL then return p end

    local dt = p.lastSampleT and (now-p.lastSampleT) or SAMPLE_INTERVAL
    p.lastSampleT = now

    -- Reset model after a teleport/respawn-sized discontinuity instead of poisoning history.
    if #p.samples > 0 then
        local prev = p.samples[#p.samples]
        local stepDt = math.max(now-prev.t, 1/120)
        local stepSpeed = (hrp.Position-prev.pos).Magnitude/stepDt
        if stepSpeed > MAX_PLAUSIBLE_TARGET_SPEED*1.5 and (hrp.Position-prev.pos).Magnitude > 15 then
            resetMotionProfile(p)
        end
    end

    local char = player.Character
    local hum = getHumanoid(char)
    local state = getHumanoidState(hum)
    local groundResult = raycastGround(char, hrp.Position)

    table.insert(p.samples, {t=now, pos=hrp.Position, state=state})
    while #p.samples > 2 and now-p.samples[1].t > HISTORY_SECONDS do
        table.remove(p.samples,1)
    end
    if #p.samples < 3 then return p end

    local fast = regressionVelocity(p.samples, SHORT_WINDOW)
    local slow = regressionVelocity(p.samples, LONG_WINDOW)
    if fast.Magnitude > MAX_PLAUSIBLE_TARGET_SPEED then fast = slow end
    if slow.Magnitude > MAX_PLAUSIBLE_TARGET_SPEED then slow = clampMagnitude(slow,MAX_PLAUSIBLE_TARGET_SPEED) end

    p.previousFastVel = p.fastVel
    p.fastVel = fast
    p.slowVel = slow

    local speed = fast.Magnitude
    p.speedEMA += (speed-p.speedEMA)*expAlpha(dt,0.18)
    p.peakSpeed = math.max(speed,p.peakSpeed*math.exp(-dt/5.5))

    local accelEstimate = (fast-slow)/math.max((LONG_WINDOW-SHORT_WINDOW)*0.5,0.05)
    p.accel = clampMagnitude(p.accel:Lerp(accelEstimate,expAlpha(dt,0.15)),MAX_ACCEL)
    p.verticalAccelEMA += (math.clamp(accelEstimate.Y,-MAX_VERTICAL_ACCEL,MAX_VERTICAL_ACCEL)-p.verticalAccelEMA)*expAlpha(dt,0.18)

    -- Signed turning / coordinated-turn evidence.
    local prevH, fastH = horizontal(p.previousFastVel), horizontal(fast)
    local signedTurnRate = 0
    if prevH.Magnitude > 4 and fastH.Magnitude > 4 then
        signedTurnRate = math.clamp(signedAngleXZ(prevH,fastH)/math.max(dt,1/120),-MAX_CIRCLE_OMEGA,MAX_CIRCLE_OMEGA)
    end
    local turnRate = math.abs(signedTurnRate)
    p.turnRateEMA += (turnRate-p.turnRateEMA)*expAlpha(dt,0.15)
    p.signedTurnRateEMA += (signedTurnRate-p.signedTurnRateEMA)*expAlpha(dt,0.13)

    local directionSample = math.abs(signedTurnRate)>0.10 and signOf(signedTurnRate) or 0
    p.turnDirectionEMA += (directionSample-p.turnDirectionEMA)*expAlpha(dt,0.19)

    local agreement = 0
    if math.abs(p.signedTurnRateEMA)>0.08 and math.abs(signedTurnRate)>0.08 then
        agreement = 1-math.clamp(math.abs(signedTurnRate-p.signedTurnRateEMA)/math.max(math.abs(p.signedTurnRateEMA),0.40),0,1)
    end
    p.turnStabilityEMA += (agreement-p.turnStabilityEMA)*expAlpha(dt,0.17)
    p.coordinatedTurnConfidence = math.clamp(math.abs(p.turnDirectionEMA)*p.turnStabilityEMA*math.clamp(turnRate/0.45,0,1),0,1)

    local fittedCenter,fittedRadius,fittedOmega,fittedRadial,fittedConfidence = fitRecentCircle(p)
    if fittedCenter then
        p.circleCenter = p.circleCenter and p.circleCenter:Lerp(fittedCenter,expAlpha(dt,0.13)) or fittedCenter
        p.circleRadius += (fittedRadius-p.circleRadius)*expAlpha(dt,0.13)
        p.circleOmega += (fittedOmega-p.circleOmega)*expAlpha(dt,0.12)
        p.circleRadialSpeed += (fittedRadial-p.circleRadialSpeed)*expAlpha(dt,0.16)
    end
    local circleRaw = math.max(fittedConfidence,p.coordinatedTurnConfidence*0.60)
    p.circleConfidence += (circleRaw-p.circleConfidence)*expAlpha(dt,0.16)

    -- Stable turning is predictable; direction disagreement / reversals are jukes.
    local dirMismatch = (1-dotUnit(fast,slow))*0.5
    local velocityMismatch = (fast-slow).Magnitude/math.max(speed,12)
    local turnFactor = math.clamp(p.turnRateEMA/7,0,1)
    local rawJuke = math.clamp(dirMismatch*0.46 + math.clamp(velocityMismatch,0,1)*0.38 + turnFactor*0.16,0,1)
    rawJuke *= 1-math.clamp(math.max(p.circleConfidence,p.coordinatedTurnConfidence)*0.82,0,0.82)
    p.jukeEMA += (rawJuke-p.jukeEMA)*expAlpha(dt,0.20)

    -- Ground clearance / jump / flight classification.
    local gravity = math.max(Workspace.Gravity,1)
    local groundY = groundResult and groundResult.Position.Y or nil
    p.groundY = groundY

    if groundY then
        local rawOffset = hrp.Position.Y-groundY
        local likelyGrounded = math.abs(fast.Y)<3.0 and rawOffset>0.25 and rawOffset<30
        if likelyGrounded then
            p.groundOffset = p.groundOffset and (p.groundOffset + (rawOffset-p.groundOffset)*expAlpha(dt,0.35)) or rawOffset
        end
    end

    local baseOffset = p.groundOffset or 3
    local aboveGround = groundY and (hrp.Position.Y-groundY-baseOffset) or 0
    local stateJump = state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall
    local stateFlying = state == Enum.HumanoidStateType.Flying
    local gravityAgreement = 1-math.clamp(math.abs(p.verticalAccelEMA + gravity)/(gravity*0.75),0,1)
    local airborne = stateJump or (groundY and aboveGround>1.6)

    if airborne then p.airborneTime += dt else p.airborneTime = 0 end

    local jumpRaw = 0
    if stateJump then jumpRaw = 1
    elseif airborne and gravityAgreement>0.45 and (math.abs(fast.Y)>2 or aboveGround>3) then
        jumpRaw = 0.55 + 0.35*gravityAgreement
    end

    local flightRaw = 0
    if stateFlying then
        flightRaw = 1
    elseif groundY and aboveGround>6 and p.airborneTime>0.22 then
        local antiGravity = 1-gravityAgreement
        local hoverOrControlled = math.clamp((antiGravity-0.25)/0.55,0,1)
        local sustained = math.clamp((p.airborneTime-0.20)/0.45,0,1)
        flightRaw = hoverOrControlled*(0.45+0.55*sustained)
    end

    if flightRaw>0.45 then jumpRaw *= 0.20 end
    p.jumpConfidence += (jumpRaw-p.jumpConfidence)*expAlpha(dt,0.12)
    p.flightConfidence += (flightRaw-p.flightConfidence)*expAlpha(dt,0.16)

    return p
end

-- ===== Multi-model prediction =====
local function predictLinearXZ(profile,currentPos,horizon)
    local juke = math.clamp(profile.jukeEMA,0,1)
    local fastH,slowH = horizontal(profile.fastVel),horizontal(profile.slowVel)
    local blend = 0.16+juke*0.68
    local v = fastH:Lerp(slowH,blend)
    local a = horizontal(profile.accel)
    local accelWeight = (1-juke)^2
    local at = math.min(horizon,0.55)
    local p = horizontal(currentPos) + v*horizon + a*(0.5*at*at*accelWeight)
    p += horizontal(profile.lateralBias)*math.clamp(horizon/0.40,0,1)
    return p
end

local function predictCoordinatedTurnXZ(profile,currentPos,horizon)
    local v = horizontal(profile.fastVel)
    local omega = profile.signedTurnRateEMA
    if v.Magnitude<4 or math.abs(omega)<0.05 or profile.coordinatedTurnConfidence<0.12 then return nil end
    local w = math.clamp(omega,-MAX_CIRCLE_OMEGA,MAX_CIRCLE_OMEGA)
    local wt = w*horizon
    local s,c = math.sin(wt),math.cos(wt)
    local dx = v.X*s/w - v.Z*(1-c)/w
    local dz = v.X*(1-c)/w + v.Z*s/w
    return horizontal(currentPos)+Vector3.new(dx,0,dz)
end

local function predictCircleXZ(profile,currentPos,horizon)
    if not profile.circleCenter or profile.circleRadius<MIN_CIRCLE_RADIUS or math.abs(profile.circleOmega)<0.06 or profile.circleConfidence<0.14 then
        return nil
    end
    local center = horizontal(profile.circleCenter)
    local radial = horizontal(currentPos)-center
    if radial.Magnitude<1 then return nil end
    local baseRadius = profile.circleRadius*0.65 + radial.Magnitude*0.35
    local futureRadius = math.clamp(baseRadius + profile.circleRadialSpeed*horizon, profile.circleRadius*0.45, profile.circleRadius*1.65)
    local angle = math.clamp(profile.circleOmega*horizon,-math.pi*1.6,math.pi*1.6)
    return center + rotateXZ(radial.Unit*futureRadius,angle)
end

local function predictOrbitXZ(profile,targetPos,serverOrigin,targetVelocity,localVelocity,horizon)
    local radial = horizontal(targetPos-serverOrigin)
    local relativeVelocity = horizontal(targetVelocity-localVelocity)
    local r,speed = radial.Magnitude,relativeVelocity.Magnitude
    if r<3 or r>MAX_CIRCLE_RADIUS or speed<4 then return nil,0 end

    local ru = radial.Unit
    local radialSpeed = relativeVelocity:Dot(ru)
    local tangential = relativeVelocity-ru*radialSpeed
    local tangentFraction = tangential.Magnitude/math.max(speed,1)
    local omega = (radial.X*relativeVelocity.Z-radial.Z*relativeVelocity.X)/math.max(r*r,1)
    if math.abs(omega)<0.06 or math.abs(omega)>MAX_CIRCLE_OMEGA then return nil,0 end

    local tangentialScore = math.clamp((tangentFraction-0.52)/0.42,0,1)
    local stability = math.max(profile.circleConfidence,profile.coordinatedTurnConfidence)
    local agreement = 1
    local learnedOmega = math.abs(profile.circleOmega)>0.06 and profile.circleOmega or profile.signedTurnRateEMA
    if math.abs(learnedOmega)>0.06 and signOf(learnedOmega)~=signOf(omega) then agreement=0.18 end
    local confidence = math.clamp(tangentialScore*(0.25+0.75*stability)*agreement,0,1)
    if confidence<0.15 then return nil,confidence end

    if math.abs(profile.circleOmega)>0.06 and signOf(profile.circleOmega)==signOf(omega) then
        omega = omega*0.45 + profile.circleOmega*0.55
    end
    local futureCenter = horizontal(serverOrigin)+horizontal(localVelocity)*horizon
    local futureRadius = math.clamp(r+radialSpeed*horizon,2,MAX_CIRCLE_RADIUS)
    local futureRadial = rotateXZ(radial.Unit*futureRadius,omega*horizon)
    return futureCenter+futureRadial,confidence
end

local function predictVerticalY(profile,currentPos,horizon)
    local y0 = currentPos.Y
    local vy = profile.fastVel.Y*0.72 + profile.slowVel.Y*0.28

    if profile.flightConfidence>0.48 then
        local ay = math.clamp(profile.verticalAccelEMA,-95,95)
        local at = math.min(horizon,0.55)
        return y0 + vy*horizon + 0.5*ay*at*at, "FLIGHT"
    end

    if profile.jumpConfidence>0.34 then
        local g = math.max(Workspace.Gravity,1)
        local y = y0 + vy*horizon - 0.5*g*horizon*horizon
        if profile.groundY and profile.groundOffset then
            local landingY = profile.groundY+profile.groundOffset
            local height = math.max(y0-landingY,0)
            local disc = vy*vy+2*g*height
            local tLand = (vy+math.sqrt(math.max(disc,0)))/g
            if tLand>=0 and horizon>tLand then y=landingY end
            y = math.max(y,landingY-0.2)
        end
        return y,"JUMP"
    end

    -- Grounded targets: reject animation/replication bobbing instead of leading vertically.
    return y0,"GROUND"
end

local function predictHRP(profile,currentPos,horizon,serverOrigin,localVelocity)
    horizon = math.clamp(horizon,0,MAX_MODEL_HORIZON)

    local linear = predictLinearXZ(profile,currentPos,horizon)
    local turn = predictCoordinatedTurnXZ(profile,currentPos,horizon)
    local circle = predictCircleXZ(profile,currentPos,horizon)
    local orbit,orbitConfidence = predictOrbitXZ(profile,currentPos,serverOrigin,profile.fastVel,localVelocity,horizon)
    profile.orbitConfidence = orbitConfidence

    -- IMM-style model blending: a stable maneuver gets a strong dedicated model, while
    -- uncertain movement stays close to the robust linear/juke model.
    local wLinear = 1.0
    local wTurn = turn and (0.25+2.0*profile.coordinatedTurnConfidence^2) or 0
    local wCircle = circle and (0.35+3.3*profile.circleConfidence^2) or 0
    local wOrbit = orbit and (0.35+4.0*orbitConfidence^2) or 0

    local maxStructured = math.max(profile.coordinatedTurnConfidence,profile.circleConfidence,orbitConfidence)
    wLinear *= math.max(0.08,1-0.82*maxStructured)

    local sum = wLinear+wTurn+wCircle+wOrbit
    local xz = linear*wLinear
    if turn then xz += turn*wTurn end
    if circle then xz += circle*wCircle end
    if orbit then xz += orbit*wOrbit end
    xz /= math.max(sum,1e-6)

    local y,verticalMode = predictVerticalY(profile,currentPos,horizon)
    local predicted = Vector3.new(xz.X,y,xz.Z)

    if verticalMode=="FLIGHT" then
        profile.movementMode="FLIGHT"
    elseif verticalMode=="JUMP" then
        profile.movementMode="JUMP"
    elseif orbitConfidence>0.52 then
        profile.movementMode="ORBIT"
    elseif profile.circleConfidence>0.52 then
        profile.movementMode="CIRCLE"
    elseif profile.coordinatedTurnConfidence>0.48 then
        profile.movementMode="TURN"
    elseif profile.jukeEMA>0.46 then
        profile.movementMode="JUKE"
    else
        profile.movementMode="GROUND"
    end

    local learnedSpeedEnvelope = math.max(20,profile.speedEMA*1.8,profile.peakSpeed*1.35)
    local displacement = predicted-currentPos
    local maxDisplacement = learnedSpeedEnvelope*horizon+7
    if displacement.Magnitude>maxDisplacement and displacement.Magnitude>0 then
        predicted = currentPos+displacement.Unit*maxDisplacement
    end
    return predicted
end

-- ===== Intercept =====
local function calculateAim(origin,localVelocity,targetHRP,targetPart,profile,pingMs)
    local pingSeconds = pingMs/1000
    local jitterSeconds = pingJitterMs/1000
    local networkLead = pingSeconds*NETWORK_RTT_FACTOR + jitterSeconds*JITTER_LEAD_FACTOR + profile.leadBiasSeconds
    networkLead = math.clamp(networkLead,0,0.52)

    local outbound = math.clamp(pingSeconds*0.5,0,0.24)
    local serverOrigin = origin+localVelocity*outbound
    local speed = math.clamp(projectileSpeedModel,MIN_PROJECTILE_SPEED,MAX_PROJECTILE_SPEED)

    local partOffset = targetPart.Position-targetHRP.Position
    local travelTime = (targetHRP.Position-serverOrigin).Magnitude/speed
    local predictedHRP = targetHRP.Position
    local horizon = networkLead+travelTime

    for _=1,5 do
        horizon = math.clamp(networkLead+travelTime,0,MAX_MODEL_HORIZON)
        predictedHRP = predictHRP(profile,targetHRP.Position,horizon,serverOrigin,localVelocity)
        travelTime = (predictedHRP-serverOrigin).Magnitude/speed
    end

    horizon = math.clamp(networkLead+travelTime,0,MAX_MODEL_HORIZON)
    predictedHRP = predictHRP(profile,targetHRP.Position,horizon,serverOrigin,localVelocity)
    local aimPos = predictedHRP+partOffset
    return aimPos,predictedHRP,horizon,travelTime,networkLead,serverOrigin
end

-- ===== Prediction residual learning =====
local function scheduleResidualLearning(player,profile,predictedHRP,expectedHorizon,shotVelocity,shotJuke)
    local confidence = math.clamp(1-shotJuke,0.12,1)
    local velocityAtShot = shotVelocity
    local speedAtShot = velocityAtShot.Magnitude

    task.delay(expectedHorizon+0.03,function()
        if not profiles[player.UserId] or not player.Character or not isAlive(player.Character) then return end
        local hrp = getHRP(player.Character)
        if not hrp then return end
        local errorVector = hrp.Position-predictedHRP
        if errorVector.Magnitude>65 then return end

        if speedAtShot>5 then
            local moveDir = velocityAtShot.Unit
            local along = errorVector:Dot(moveDir)
            local timeError = along/speedAtShot
            local correction = math.clamp(timeError,-0.22,0.22)*0.075*confidence
            profile.leadBiasSeconds = math.clamp(profile.leadBiasSeconds+correction,-0.22,0.34)

            if profile.movementMode~="CIRCLE" and profile.movementMode~="ORBIT" then
                local lateral = errorVector-moveDir*along
                lateral = clampMagnitude(lateral,15)
                profile.lateralBias = profile.lateralBias:Lerp(lateral*0.25,0.045*confidence)
            end
        end
        profile.shotsLearned += 1
    end)
end

-- ===== Shot / hit feedback =====
local function newestMatchingShot(victimHumanoid,maxAge)
    local now=os.clock()
    for i=#shots,1,-1 do
        local s=shots[i]
        if now-s.fireTime<=maxAge and not s.finalHit then
            if not victimHumanoid or s.targetHumanoid==victimHumanoid then return s end
        end
    end
    return nil
end

local function markShotHit(shot,strength,source)
    if not shot or shot.finalHit then return end
    local p=profiles[shot.targetUserId]
    if not p then return end

    if strength=="confirmed" then
        shot.finalHit=true
        shot.hitStrength="confirmed"
        p.confirmedHits += 1
    elseif strength=="probable" then
        shot.finalHit=true
        shot.hitStrength="probable"
        p.probableHits += 1
    else
        return
    end
    p.lastHitSource=source or strength
end

local function describeArg(v)
    local ty=typeof(v)
    if ty=="Instance" then return v.ClassName..":"..v:GetFullName() end
    if ty=="Vector3" then return string.format("Vector3(%.1f,%.1f,%.1f)",v.X,v.Y,v.Z) end
    return ty..":"..tostring(v)
end

local function inspectFeedbackArgs(sourceName,...)
    local args=table.pack(...)
    local victimHumanoid=nil
    local attacker=nil
    local sourceInstance=nil
    local amount=nil
    local textTags={}

    for i=1,args.n do
        local v=args[i]
        if typeof(v)=="Instance" then
            if v:IsA("Humanoid") then
                victimHumanoid = victimHumanoid or v
            elseif v:IsA("Player") then
                if v==LocalPlayer then attacker=v end
                local h=getHumanoid(v.Character)
                if h and not victimHumanoid and v~=LocalPlayer then victimHumanoid=h end
            elseif v:IsA("Model") then
                local h=v:FindFirstChildOfClass("Humanoid")
                if h then victimHumanoid=victimHumanoid or h end
                if LocalPlayer.Character and v==LocalPlayer.Character then sourceInstance=v end
            elseif LocalPlayer.Character and v:IsDescendantOf(LocalPlayer.Character) then
                sourceInstance=v
            end
        elseif type(v)=="number" then
            amount=amount or v
        elseif type(v)=="string" then
            table.insert(textTags,string.lower(v))
        elseif type(v)=="table" then
            -- Common table-shaped payloads. Read only obvious fields; never assume schema.
            local okA,a=pcall(function() return v.attacker or v.Attacker or v.source or v.Source end)
            if okA and typeof(a)=="Instance" then
                if a==LocalPlayer or (LocalPlayer.Character and a==LocalPlayer.Character) then attacker=LocalPlayer end
            end
            local okV,vic=pcall(function() return v.humanoid or v.Humanoid or v.victim or v.Victim end)
            if okV and typeof(vic)=="Instance" then
                if vic:IsA("Humanoid") then victimHumanoid=victimHumanoid or vic
                elseif vic:IsA("Model") then victimHumanoid=victimHumanoid or vic:FindFirstChildOfClass("Humanoid") end
            end
        end
    end

    local tagText=table.concat(textTags," ")
    local saysFireball = string.find(tagText,"fireball",1,true) or string.find(tagText,"newfireball",1,true) or string.find(tagText,"fire ball",1,true)
    local shot=newestMatchingShot(victimHumanoid,2.2)
    if not shot then return end

    local now=os.clock()
    local timingError=math.abs(now-shot.expectedImpactTime)
    local nearExpected = timingError <= math.max(0.48,(shot.pingMs/1000)+0.20)
    local sourceIsUs = attacker==LocalPlayer or sourceInstance~=nil

    if sourceIsUs and (not victimHumanoid or victimHumanoid==shot.targetHumanoid) then
        markShotHit(shot,"confirmed",sourceName..":source=LocalPlayer")
    elseif saysFireball and nearExpected and (not victimHumanoid or victimHumanoid==shot.targetHumanoid) then
        markShotHit(shot,"probable",sourceName..":fireball-tag")
    elseif nearExpected and shot.probableContact and (not victimHumanoid or victimHumanoid==shot.targetHumanoid) then
        markShotHit(shot,"probable",sourceName..":projectile+timing")
    else
        local p=profiles[shot.targetUserId]
        if p then p.ambiguousDamageEvents += 1 end
    end

    if amount then shot.lastObservedDamage=amount end
end

