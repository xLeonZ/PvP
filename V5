-- ===== Math helpers =====
local ZERO = Vector3.new(0, 0, 0)

local function clampMagnitude(v, maxMag)
    local m = v.Magnitude
    if m > maxMag and m > 0 then
        return v.Unit * maxMag
    end
    return v
end

local function expAlpha(dt, tau)
    if tau <= 0 then return 1 end
    return 1 - math.exp(-dt / tau)
end

local function safeUnit(v)
    local m = v.Magnitude
    if m < 1e-5 then return ZERO end
    return v / m
end

local function dotUnit(a, b)
    local ua, ub = safeUnit(a), safeUnit(b)
    if ua.Magnitude == 0 or ub.Magnitude == 0 then return 1 end
    return math.clamp(ua:Dot(ub), -1, 1)
end

local function horizontal(v)
    return Vector3.new(v.X, 0, v.Z)
end

local function signOf(x)
    if x > 0 then return 1 end
    if x < 0 then return -1 end
    return 0
end

local function signedAngleXZ(a, b)
    a, b = horizontal(a), horizontal(b)
    if a.Magnitude < 1e-5 or b.Magnitude < 1e-5 then return 0 end
    a, b = a.Unit, b.Unit
    local cross = a.X * b.Z - a.Z * b.X
    local dot = math.clamp(a:Dot(b), -1, 1)
    return math.atan2(cross, dot)
end

local function rotateXZ(v, angle)
    local c, s = math.cos(angle), math.sin(angle)
    return Vector3.new(v.X * c - v.Z * s, v.Y, v.X * s + v.Z * c)
end

local function smoothstep01(x)
    x = math.clamp(x, 0, 1)
    return x * x * (3 - 2 * x)
end

local function solve3x3(a11,a12,a13,a21,a22,a23,a31,a32,a33,b1,b2,b3)
    local det = a11*(a22*a33-a23*a32) - a12*(a21*a33-a23*a31) + a13*(a21*a32-a22*a31)
    if math.abs(det) < 1e-7 then return nil end

    local d1 = b1*(a22*a33-a23*a32) - a12*(b2*a33-a23*b3) + a13*(b2*a32-a22*b3)
    local d2 = a11*(b2*a33-a23*b3) - b1*(a21*a33-a23*a31) + a13*(a21*b3-b2*a31)
    local d3 = a11*(a22*b3-b2*a32) - a12*(a21*b3-b2*a31) + b1*(a21*a32-a22*a31)
    return d1/det, d2/det, d3/det
end

-- ===== Character helpers =====
local function isAlive(char)
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end

local function findPlayerByPartial(name)
    if not name or name == "" then return nil end
    local needle = string.lower(name)

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and (string.lower(p.Name) == needle or string.lower(p.DisplayName) == needle) then
            return p
        end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if string.find(string.lower(p.Name), needle, 1, true)
                or string.find(string.lower(p.DisplayName), needle, 1, true) then
                return p
            end
        end
    end
    return nil
end

local function getHRP(char)
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid(char)
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function getTargetPart(char)
    if not char then return nil end
    local cfg = BODY_PARTS[currentBodyPartIndex]

    if cfg.name == "Feet" then
        -- Support common R15/R6 naming and a few custom-rig leg names before falling back.
        for _, name in ipairs({
            "RightFoot", "LeftFoot", "RightLowerLeg", "LeftLowerLeg",
            "Right Leg", "Left Leg", "RightLeg", "LeftLeg"
        }) do
            local part = char:FindFirstChild(name)
            if part and part:IsA("BasePart") then return part end
        end
    end

    return char:FindFirstChild(cfg.part)
        or char:FindFirstChild(cfg.fallback)
        or char:FindFirstChild("HumanoidRootPart")
end

local function belongsToCharacter(part)
    local node = part
    for _ = 1, 6 do
        if not node then break end
        if node:IsA("Model") and node:FindFirstChildOfClass("Humanoid") then
            return true
        end
        node = node.Parent
    end
    return false
end

local function getHumanoidState(hum)
    if not hum then return nil end
    local ok, state = pcall(function() return hum:GetState() end)
    return ok and state or nil
end

local function raycastGround(char, origin)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local exclude = {}
    if char then table.insert(exclude, char) end
    if LocalPlayer.Character then table.insert(exclude, LocalPlayer.Character) end
    params.FilterDescendantsInstances = exclude
    params.IgnoreWater = false

    local result = Workspace:Raycast(origin + Vector3.new(0, 2, 0), Vector3.new(0, -120, 0), params)
    return result
end

-- ===== Ping / jitter =====
local function getPingMs()
    local ok, seconds = pcall(function() return LocalPlayer:GetNetworkPing() end)
    if not ok or type(seconds) ~= "number" then
        return smoothedPingMs or 0
    end

    local rawMs = math.max(0, seconds * 1000)
    if not smoothedPingMs then
        smoothedPingMs = rawMs
        pingJitterMs = 0
    else
        local deviation = math.abs(rawMs - smoothedPingMs)
        pingJitterMs += (deviation - pingJitterMs) * 0.12
        smoothedPingMs += (rawMs - smoothedPingMs) * 0.22
    end
    return smoothedPingMs
end

